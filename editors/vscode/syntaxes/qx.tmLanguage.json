{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Qxide",
  "scopeName": "source.qx",
  "fileTypes": ["qx"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#import" },
    { "include": "#function-declaration" },
    { "include": "#type-parameters" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#builtin-call" },
    { "include": "#method" },
    { "include": "#function-call" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.double-slash.qx",
      "begin": "//",
      "beginCaptures": { "0": { "name": "punctuation.definition.comment.qx" } },
      "end": "$"
    },
    "string": {
      "name": "string.quoted.double.qx",
      "begin": "\"",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.qx" } },
      "end": "\"",
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.qx" } },
      "patterns": [
        { "name": "constant.character.escape.qx", "match": "\\\\[nt\\\\\"]" },
        { "name": "invalid.illegal.unknown-escape.qx", "match": "\\\\." },
        { "name": "constant.other.placeholder.qx", "match": "\\{\\}" }
      ]
    },
    "import": {
      "name": "meta.import.qx",
      "begin": "\\b(import)\\b",
      "beginCaptures": { "1": { "name": "keyword.control.import.qx" } },
      "end": ";",
      "endCaptures": { "0": { "name": "punctuation.terminator.qx" } },
      "patterns": [
        { "include": "#comment" },
        { "name": "keyword.operator.wildcard.qx", "match": "\\*" },
        { "name": "punctuation.separator.dot.qx", "match": "\\." },
        { "name": "entity.name.namespace.qx", "match": "[\\p{L}_][\\p{L}\\p{N}_]*(?=\\s*\\.)" },
        { "name": "entity.name.function.qx", "match": "[\\p{L}_][\\p{L}\\p{N}_]*" }
      ]
    },
    "function-declaration": {
      "match": "\\b(int|double|boolean|void|Bit|BitReg|Qubit|QReg)\\s+([\\p{L}_][\\p{L}\\p{N}_]*)\\s*(?=\\()",
      "captures": {
        "1": { "name": "storage.type.qx" },
        "2": { "name": "entity.name.function.qx" }
      }
    },
    "type-parameters": {
      "patterns": [
        {
          "comment": "`<T, U>` before a generic function's return type",
          "match": "^\\s*(?:(public)\\s+)?(<)([^<>]*)(>)",
          "captures": {
            "1": { "name": "storage.modifier.qx" },
            "2": { "name": "punctuation.definition.typeparameters.begin.qx" },
            "3": { "patterns": [{ "include": "#type-parameter-bound" }, { "include": "#type-parameter-name" }] },
            "4": { "name": "punctuation.definition.typeparameters.end.qx" }
          }
        },
        {
          "comment": "`interface Ordered<T>`",
          "match": "\\b(interface)\\s+([\\p{L}_][\\p{L}\\p{N}_]*)\\s*(<)([^<>]*)(>)",
          "captures": {
            "1": { "name": "storage.type.interface.qx" },
            "2": { "name": "entity.name.type.qx" },
            "3": { "name": "punctuation.definition.typeparameters.begin.qx" },
            "4": { "patterns": [{ "include": "#type-parameter-name" }] },
            "5": { "name": "punctuation.definition.typeparameters.end.qx" }
          }
        },
        {
          "comment": "`struct Pair<A, B>` and `enum Option<T>`",
          "match": "\\b(struct|enum)\\s+([\\p{L}_][\\p{L}\\p{N}_]*)\\s*(<)([^<>]*)(>)",
          "captures": {
            "1": { "patterns": [{ "include": "#keywords" }] },
            "2": { "name": "entity.name.type.qx" },
            "3": { "name": "punctuation.definition.typeparameters.begin.qx" },
            "4": { "patterns": [{ "include": "#type-parameter-name" }] },
            "5": { "name": "punctuation.definition.typeparameters.end.qx" }
          }
        }
      ]
    },
    "type-parameter-bound": {
      "comment": "`extends Shape` in `<T extends Shape>`",
      "match": "\\b(extends)\\s+([\\p{L}_][\\p{L}\\p{N}_]*)",
      "captures": {
        "1": { "name": "keyword.other.extends.qx" },
        "2": { "name": "entity.name.type.qx" }
      }
    },
    "type-parameter-name": {
      "name": "entity.name.type.parameter.qx",
      "match": "[\\p{L}_][\\p{L}\\p{N}_]*"
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.qx", "match": "\\b(if|else|for|in|while|break|continue|return|match)\\b" },
        { "name": "keyword.other.new.qx", "match": "\\bnew\\b(?=\\s+[A-Za-z_])" },
        { "name": "storage.modifier.extern.qx", "match": "^\\s*extern\\b(?=\\s*\")" },
        { "name": "storage.modifier.qx", "match": "\\b(final|var|consume|public)\\b" },
        { "name": "storage.type.struct.qx", "match": "\\bstruct\\b" },
        { "name": "storage.type.enum.qx", "match": "\\benum\\b" },
        { "name": "storage.type.interface.qx", "match": "\\binterface\\b(?=\\s+[\\p{L}_])" },
        { "name": "keyword.other.implements.qx", "match": "\\bimplements\\b(?=\\s+[\\p{L}_])" },
        { "name": "keyword.other.extends.qx", "match": "\\bextends\\b(?=\\s+[\\p{L}_])" },
        { "name": "variable.language.this.qx", "match": "\\bthis\\b" },
        {
          "name": "keyword.other.reserved.qx",
          "match": "\\b(loop|impl|use|mod|const|with_ancilla|apply|let|fn|mut)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        { "name": "storage.type.primitive.qx", "match": "\\b(int|double|boolean|void)\\b" },
        { "name": "storage.type.quantum.qx", "match": "\\b(Bit|BitReg|Qubit|QReg)\\b" },
        { "name": "support.type.prelude.qx", "match": "\\b(Result|Option)\\b" },
        { "name": "support.type.builtin.qx", "match": "\\b(List|Map|Random)\\b" }
      ]
    },
    "constants": {
      "patterns": [
        { "name": "constant.language.boolean.qx", "match": "\\b(true|false)\\b" },
        { "name": "constant.language.pi.qx", "match": "\\bPI\\b" },
        { "name": "support.constant.variant.qx", "match": "\\b(Ok|Err|Some|None)\\b" }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.qx",
          "match": "\\b[0-9][0-9_]*(?:\\.[0-9][0-9_]*(?:[eE][+-]?[0-9]+)?|[eE][+-]?[0-9]+)\\b"
        },
        { "name": "constant.numeric.integer.qx", "match": "\\b[0-9][0-9_]*\\b" }
      ]
    },
    "builtin-call": {
      "match": "\\b(qubit|qreg|h|x|z|s|sdg|t|tdg|reset|rx|ry|rz|cx|ccx|measure|discard|len|println)\\s*(?=\\()",
      "captures": { "1": { "name": "support.function.builtin.qx" } }
    },
    "method": {
      "match": "(\\.)\\s*(as_int|to_binary|length|substring|char_at|index_of|contains|starts_with|ends_with|to_upper|to_lower|trim|replace|repeat|parse_int|parse_double|try_parse_int|try_parse_double|split|split_whitespace|lines|chars|join|add|get|set|insert|remove_at|pop|clear|size|is_empty|to_array|put|get_or|contains_key|remove|keys|values|next_int|next_double|next_bool)\\b",
      "captures": {
        "1": { "name": "punctuation.accessor.qx" },
        "2": { "name": "support.function.method.qx" }
      }
    },
    "function-call": {
      "match": "([\\p{L}_][\\p{L}\\p{N}_]*)\\s*(?=\\()",
      "captures": { "1": { "name": "entity.name.function.call.qx" } }
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.range.qx", "match": "\\.\\." },
        { "name": "keyword.operator.try.qx", "match": "\\?" },
        { "name": "keyword.operator.arrow.qx", "match": "->|=>" },
        { "name": "keyword.operator.assignment.compound.qx", "match": ">>>=|>>=|<<=|[&|^]=" },
        { "name": "keyword.operator.bitwise.shift.qx", "match": "<<|(?<=\\s)>>>?" },
        { "name": "keyword.operator.comparison.qx", "match": "==|!=|<=|>=|<|>" },
        { "name": "keyword.operator.logical.qx", "match": "&&|\\|\\||!" },
        { "name": "keyword.operator.bitwise.qx", "match": "[&|^~]" },
        { "name": "keyword.operator.assignment.compound.qx", "match": "[-+*/%]=" },
        { "name": "keyword.operator.assignment.qx", "match": "=" },
        { "name": "keyword.operator.arithmetic.qx", "match": "[-+*/%]" }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.terminator.qx", "match": ";" },
        { "name": "punctuation.separator.comma.qx", "match": "," },
        { "name": "punctuation.accessor.qx", "match": "\\." }
      ]
    }
  }
}
