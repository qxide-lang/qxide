import std.fs;
import std.log;
import std.time;

// Called by the page with `qxide.invoke("measure_bell", {}, { shots: 1000 })`.
// The runtime simulates the shots and returns how often each result occurred.
public BitReg measure_bell() {
    QReg q = qreg(2);
    h(q[0]);
    cx(q[0], q[1]);
    return measure(q);
}

// Appends one line to results.txt in the app's data folder and returns it.
public String save_result(String text) {
    String line = time.nowIso() + "  " + text;
    fs.appendString("results.txt", line + "\n");
    log.info("saved " + line);
    return line;
}

// Everything saved so far, or an empty string before the first save.
public String history() {
    if (!fs.exists("results.txt")) {
        return "";
    }
    return fs.readString("results.txt");
}
