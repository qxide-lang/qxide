// Text tools and collections: split, for-each, List, Map, a seeded Random and bit operators.
// Everything here is classical, so it runs the same in every engine and in the playground.
import std.math;

int popcount(int x) {
    int n = 0;
    int v = x;
    while v != 0 {
        n += v & 1;
        v = v >>> 1;
    }
    return n;
}

<T> List<T> reversed(List<T> xs) {
    List<T> out = new List();
    for i in 0..xs.size() {
        out.add(xs.get(xs.size() - 1 - i));
    }
    return out;
}

void main() {
    String text = "the quick brown fox jumps over the lazy dog the end";
    Map<String, int> counts = new Map();
    for word in text.splitWhitespace() {
        counts.put(word, counts.getOrDefault(word, 0) + 1);
    }
    // Keys come back in the order they were first added.
    for word in counts.keys() {
        if counts.getOrDefault(word, 0) > 1 {
            println("{} x{}", word, counts.getOrDefault(word, 0));
        }
    }
    println("{} distinct words", counts.size());

    List<String> long_words = new List();
    for word in counts.keys() {
        if word.length() >= 5 {
            long_words.add(word);
        }
    }
    println("{}", ", ".join(reversed(long_words).toArray()));

    // Dice with a fixed seed: the same rolls on every run and every host.
    Random rng = new Random(2024);
    int[] faces = new int[6];
    for i in 0..600 {
        faces[rng.nextInt(6)] += 1;
    }
    int most = 0;
    for f in faces {
        most = math.maxInt(most, f);
    }
    println("most frequent face: {} rolls", most);

    int flags = 0;
    flags |= 1 << 3;
    flags |= 1 << 5;
    flags ^= 1;
    println("flags {} has {} bits set, bit 5 is {}", flags, popcount(flags), flags >> 5 & 1 == 1);

    match long_words.pop() {
        Some(w) => {
            println("last long word: {}", w);
        }
        None => {
            println("no long words");
        }
    }
}
