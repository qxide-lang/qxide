// `String` methods and the pure `std.math` module: parse a record, compute with it, and use
// the result as a rotation angle.
import std.math;

double distance(double x, double y) {
    return math.sqrt(x * x + y * y);
}

void main() {
    String record = "  probe-7: 3.0, 4.0  ".trim();
    int colon = record.index_of(":");
    String name = record.substring(0, colon).to_upper();
    String coords = record.substring(colon + 1, record.length());
    int comma = coords.index_of(",");
    double x = coords.substring(0, comma).parse_double();
    double y = coords.substring(comma + 1, coords.length()).parse_double();
    double d = distance(x, y);
    println("{} is {} away ({} cells)", name, d, (int) math.floor(d / 2));
    Qubit q = qubit();
    ry(q, PI / d);
    Bit b = measure(q);
    println("{}", b);
}
