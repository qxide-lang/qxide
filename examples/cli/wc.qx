// A small `wc`: counts the lines, words and characters of standard input and prints them as
// soon as the input ends. Run it with `qxide run examples/cli/wc.qx < notes.txt`, or pass
// `-l` or `-w` after `--` to print only the line or word count. With `-f`, it also lists each
// word with its count, most frequent first.
import std.io;

int main(String[] args) {
    String only = "";
    boolean freq = false;
    for arg in args {
        match arg {
            "-l" => {
                only = "lines";
            }
            "-w" => {
                only = "words";
            }
            "-f" => {
                freq = true;
            }
            _ => {
                io.write_err_line("wc: unknown option " + arg);
                return 2;
            }
        }
    }
    int lines = 0;
    int words = 0;
    int chars = 0;
    Map<String, int> counts = new Map();
    boolean more = true;
    while more {
        match io.read_line() {
            Some(text) => {
                lines += 1;
                chars += text.length() + 1;
                for word in text.split_whitespace() {
                    words += 1;
                    counts.put(word, counts.get_or(word, 0) + 1);
                }
            }
            None => {
                more = false;
            }
        }
    }
    if only == "lines" {
        io.write_line("" + lines);
    } else if only == "words" {
        io.write_line("" + words);
    } else {
        io.write_line(lines + " " + words + " " + chars);
    }
    if freq {
        // Highest count first; words with the same count keep their first-seen order.
        List<String> order = new List();
        for word in counts.keys() {
            int at = order.size();
            while at > 0 && counts.get_or(order.get(at - 1), 0) < counts.get_or(word, 0) {
                at -= 1;
            }
            order.insert(at, word);
        }
        for word in order {
            io.write_line(counts.get_or(word, 0) + " " + word);
        }
    }
    return 0;
}
