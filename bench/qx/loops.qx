// bench: shots=1
// Nested loops over many live locals (variable lookups dominate).
void main() {
    int a = 1;
    int b = 2;
    int c = 3;
    int d = 4;
    int e = 5;
    int f = 6;
    int g = 7;
    int h = 8;
    int seed = 12345;
    for i in 0..300 {
        for j in 0..300 {
            seed = (seed * 1103515245 + 12345) % 2147483648;
            a = (a + seed % 7) % 1000003;
            b = (b + a * 3) % 1000003;
            c = (c + b - a) % 1000003;
            d = (d + c * j) % 1000003;
            e = (e + d + i) % 1000003;
            f = (f * 2 + e) % 1000003;
            g = (g + f % 11) % 1000003;
            h = (h + g + j * i) % 1000003;
        }
    }
    println("{} {} {} {} {} {} {} {}", a, b, c, d, e, f, g, h);
}
